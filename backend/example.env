# Copy this file to .env and fill in real values. Never commit .env.

# development | staging | testing | production
NODE_ENV=development
PORT=3030
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Pooled connection (host contains "-pooler"): used by the running app
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full"
# Direct connection (no "-pooler"): used only for migrations (drizzle-kit)
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=verify-full"

# Optional connection pool tuning (defaults shown)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000